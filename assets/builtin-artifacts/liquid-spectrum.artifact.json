{
  "contract": "1.0",
  "meta": {
    "id": "liquid-spectrum",
    "name": "Liquid Spectrum",
    "description": "A liquid horizon: two mirrored polylines trace a smoothed spectrum curve whose amplitude is var-smoothed for a fluid, sloshing feel. A third translucent polyline, slightly offset, fills the body between them. The whole surface bobs gently with low end and its hue drifts slowly along the curve. Silence flattens the liquid to a calm dim line. A mirror toggle reflects the curve below the horizon.",
    "author": "ViewMusic built-in"
  },
  "settings": {
    "amplitude": { "type": "number", "label": "Amplitude", "min": 0.05, "max": 0.7, "step": 0.01, "default": 0.32 },
    "smoothness": { "type": "number", "label": "Smoothness", "min": 0, "max": 0.95, "step": 0.01, "default": 0.7 },
    "hue": { "type": "color", "label": "Palette hue", "default": "#22ccaa" },
    "mirror": { "type": "toggle", "label": "Mirror", "default": true }
  },
  "vars": {
    "amp": { "init": "0", "frame": "mix(energy, amp, settings.smoothness)" },
    "bob": { "init": "0", "frame": "bob * 0.9 + low * 0.1" },
    "drift": { "init": "0", "frame": "drift + dt * (0.05 + 0.4 * energy)" }
  },
  "scene": [
    {
      "type": "polyline",
      "points": 160,
      "thickness": "9 + 22 * amp",
      "closed": false,
      "blend": "add",
      "point": {
        "x": "-1 + 2 * u",
        "y": "-0.04 + 0.12 * bob - 0.05 + settings.amplitude * (0.2 + 1.4 * amp) * (0.5 * band(u) + 0.5 * band(clamp(u + 0.05, 0, 1)))",
        "color": {
          "model": "hsva",
          "h": "(settings.hue_r * 120 + settings.hue_g * 240 + settings.hue_b * 360 + drift * 40 + 90 * u)",
          "s": "0.55",
          "v": "0.06 + 0.32 * smoothstep(0.02, 0.12, energy) * (0.3 + 0.7 * band(u))",
          "a": "0.45"
        }
      }
    },
    {
      "type": "polyline",
      "points": 160,
      "thickness": "2.5 + 5 * amp",
      "closed": false,
      "blend": "add",
      "point": {
        "x": "-1 + 2 * u",
        "y": "0.12 * bob + settings.amplitude * (0.2 + 1.4 * amp) * (0.5 * band(u) + 0.5 * band(clamp(u + 0.05, 0, 1)))",
        "color": {
          "model": "hsva",
          "h": "(settings.hue_r * 120 + settings.hue_g * 240 + settings.hue_b * 360 + drift * 40 + 120 * u)",
          "s": "0.85",
          "v": "0.2 + 0.8 * smoothstep(0.02, 0.12, energy) * (0.35 + 0.65 * band(u))",
          "a": "0.95"
        }
      }
    },
    {
      "type": "polyline",
      "points": 160,
      "thickness": "2.5 + 5 * amp",
      "closed": false,
      "blend": "add",
      "visible": "settings.mirror",
      "point": {
        "x": "-1 + 2 * u",
        "y": "-0.16 + 0.12 * bob - settings.amplitude * (0.2 + 1.4 * amp) * (0.5 * band(u) + 0.5 * band(clamp(u + 0.05, 0, 1)))",
        "color": {
          "model": "hsva",
          "h": "(settings.hue_r * 120 + settings.hue_g * 240 + settings.hue_b * 360 + drift * 40 + 120 * u + 30)",
          "s": "0.8",
          "v": "0.15 + 0.6 * smoothstep(0.02, 0.12, energy) * (0.35 + 0.65 * band(u))",
          "a": "0.8"
        }
      }
    }
  ],
  "feedback": { "decay": "0.78 + 0.12 * amp" }
}
