{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viewmusic.local/schemas/artifact-1.0.json",
  "title": "ViewMusic Visual Artifact",
  "description": "Contract v1.0 for ViewMusic visual artifacts. Design-time reference; the canonical published schema is generated from the implementation types via schemars and must stay equivalent (CI round-trip test).",
  "type": "object",
  "required": ["contract", "meta", "scene"],
  "additionalProperties": false,
  "properties": {
    "contract": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$",
      "description": "Contract version MAJOR.MINOR; this schema covers 1.x"
    },
    "meta": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 64 },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "maxLength": 1000 },
        "author": { "type": "string", "maxLength": 200 }
      }
    },
    "settings": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": { "pattern": "^[a-z][a-zA-Z0-9_]*$" },
      "additionalProperties": { "$ref": "#/$defs/settingDecl" }
    },
    "vars": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": { "pattern": "^[a-z][a-zA-Z0-9_]*$" },
      "additionalProperties": { "$ref": "#/$defs/varDecl" }
    },
    "scene": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/layer" }
    },
    "feedback": {
      "type": "object",
      "required": ["decay"],
      "additionalProperties": false,
      "properties": { "decay": { "$ref": "#/$defs/formula" } }
    }
  },
  "$defs": {
    "formula": {
      "description": "A constant number or a formula expression string (compiled and identifier-checked at load; max 256 ops, nesting 32)",
      "oneOf": [
        { "type": "number" },
        { "type": "string", "minLength": 1, "maxLength": 1024 }
      ]
    },
    "settingDecl": {
      "type": "object",
      "required": ["type", "label", "default"],
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "type": { "const": "number" },
            "label": { "$ref": "#/$defs/label" },
            "min": { "type": "number" },
            "max": { "type": "number" },
            "step": { "type": "number", "exclusiveMinimum": 0 },
            "default": { "type": "number" }
          },
          "required": ["type", "label", "min", "max", "default"]
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": { "const": "toggle" },
            "label": { "$ref": "#/$defs/label" },
            "default": { "type": "boolean" }
          },
          "required": ["type", "label", "default"]
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": { "const": "choice" },
            "label": { "$ref": "#/$defs/label" },
            "options": {
              "type": "array",
              "minItems": 2,
              "maxItems": 16,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 40 }
            },
            "default": { "type": "string" }
          },
          "required": ["type", "label", "options", "default"]
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": { "const": "color" },
            "label": { "$ref": "#/$defs/label" },
            "default": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$" }
          },
          "required": ["type", "label", "default"]
        }
      ]
    },
    "label": { "type": "string", "minLength": 1, "maxLength": 40 },
    "varDecl": {
      "type": "object",
      "required": ["init", "frame"],
      "additionalProperties": false,
      "properties": {
        "init": { "$ref": "#/$defs/formula" },
        "frame": { "$ref": "#/$defs/formula" }
      }
    },
    "color": {
      "type": "object",
      "required": ["model"],
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "model": { "const": "rgba" },
            "r": { "$ref": "#/$defs/formula" },
            "g": { "$ref": "#/$defs/formula" },
            "b": { "$ref": "#/$defs/formula" },
            "a": { "$ref": "#/$defs/formula" }
          },
          "required": ["model", "r", "g", "b"]
        },
        {
          "additionalProperties": false,
          "properties": {
            "model": { "const": "hsva" },
            "h": { "$ref": "#/$defs/formula" },
            "s": { "$ref": "#/$defs/formula" },
            "v": { "$ref": "#/$defs/formula" },
            "a": { "$ref": "#/$defs/formula" }
          },
          "required": ["model", "h", "s", "v"]
        }
      ]
    },
    "layer": {
      "oneOf": [
        { "$ref": "#/$defs/instancedLayer" },
        { "$ref": "#/$defs/polylineLayer" },
        { "$ref": "#/$defs/fieldLayer" }
      ]
    },
    "blend": { "enum": ["alpha", "add"], "default": "alpha" },
    "instancedLayer": {
      "type": "object",
      "required": ["type", "shape", "count", "element"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "instanced" },
        "shape": { "enum": ["rect", "circle", "triangle"] },
        "count": { "$ref": "#/$defs/formula" },
        "blend": { "$ref": "#/$defs/blend" },
        "visible": { "$ref": "#/$defs/formula" },
        "element": {
          "type": "object",
          "required": ["x", "y", "w", "h", "color"],
          "additionalProperties": false,
          "properties": {
            "x": { "$ref": "#/$defs/formula" },
            "y": { "$ref": "#/$defs/formula" },
            "w": { "$ref": "#/$defs/formula" },
            "h": { "$ref": "#/$defs/formula" },
            "rot": { "$ref": "#/$defs/formula" },
            "color": { "$ref": "#/$defs/color" }
          }
        }
      }
    },
    "polylineLayer": {
      "type": "object",
      "required": ["type", "points", "thickness", "point"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "polyline" },
        "points": { "$ref": "#/$defs/formula" },
        "thickness": { "$ref": "#/$defs/formula" },
        "closed": { "type": "boolean", "default": false },
        "blend": { "$ref": "#/$defs/blend" },
        "visible": { "$ref": "#/$defs/formula" },
        "point": {
          "type": "object",
          "required": ["x", "y", "color"],
          "additionalProperties": false,
          "properties": {
            "x": { "$ref": "#/$defs/formula" },
            "y": { "$ref": "#/$defs/formula" },
            "color": { "$ref": "#/$defs/color" }
          }
        }
      }
    },
    "fieldLayer": {
      "type": "object",
      "required": ["type", "resolution", "cell"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "field" },
        "resolution": { "$ref": "#/$defs/formula" },
        "blend": { "$ref": "#/$defs/blend" },
        "visible": { "$ref": "#/$defs/formula" },
        "cell": {
          "type": "object",
          "required": ["color"],
          "additionalProperties": false,
          "properties": {
            "color": { "$ref": "#/$defs/color" }
          }
        }
      }
    }
  }
}
