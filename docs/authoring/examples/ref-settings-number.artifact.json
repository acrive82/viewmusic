{
  "contract": "1.0",
  "meta": {
    "id": "ref-settings-number",
    "name": "Reference: Number Setting",
    "description": "A number setting renders a slider. Here settings.count drives how many circles ring the center; read it with the settings. prefix and use it as the layer count.",
    "author": "ViewMusic authoring manual"
  },
  "settings": {
    "count": {
      "type": "number",
      "label": "Dots",
      "min": 3,
      "max": 64,
      "step": 1,
      "default": 18
    },
    "radius": {
      "type": "number",
      "label": "Radius",
      "min": 0.1,
      "max": 0.9,
      "step": 0.05,
      "default": 0.6
    }
  },
  "scene": [
    {
      "type": "instanced",
      "shape": "circle",
      "blend": "add",
      "count": "settings.count",
      "element": {
        "x": "settings.radius * cos(u * tau) / aspect",
        "y": "settings.radius * sin(u * tau)",
        "w": "0.06 / aspect",
        "h": "0.06",
        "rot": "0",
        "color": {
          "model": "hsva",
          "h": "u * 360",
          "s": "0.8",
          "v": "0.1 + 0.7 * smoothstep(0.02, 0.2, energy)",
          "a": "1"
        }
      }
    }
  ]
}
